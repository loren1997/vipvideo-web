# 先复制为 .env，再设置一个至少 16 位的家庭访问密码。
APP_PASSWORD=
# 局域网 HTTP 使用 false；通过 HTTPS 反向代理访问时改为 true。
COOKIE_SECURE=false
# 兼容播放：默认自动尝试可用的 Intel VAAPI，失败后使用 CPU；software 强制 CPU。
TRANSCODE_ENABLED=true
TRANSCODE_ACCEL=auto
TRANSCODE_ALLOW_SOFTWARE=true
# Plex 保护配置自动设置 low，降低后台发现与直播探测频率。
BACKGROUND_MODE=normal
FFMPEG_PATH=ffmpeg
# Compose 已为 web 配置动态网页助手 http://quark-browser:3020，无需填写 Cookie。
# 可选：公开资源搜索使用的 HTTP 代理，如 http://192.168.1.10:7890；透明代理网络留空。
QUARK_SEARCH_PROXY=
# 可选：内部多平台弹幕服务独立令牌；web 与 danmaku 使用相同值，不要填写夸克 Cookie。
# 现有部署用更新脚本 --danmaku 在缺少令牌时自动生成随机值；此服务不发布宿主机端口。
DANMAKU_API_TOKEN=
# 仅启用 compose.gpu.yaml 时填写，值来自 Ubuntu：stat -c %g /dev/dri/renderD128
RENDER_GID=
